# Application
DEBUG=false
REDIS_URL=redis://localhost:6379/0
SEARXNG_URL=http://localhost:8080
CACHE_TTL_SECONDS=21600
SCRAPER_TIMEOUT_SECONDS=8.0
WB_MIN_REQUEST_INTERVAL_SECONDS=1.5
WB_CIRCUIT_BREAKER_SECONDS=600
WB_CACHE_ENABLED=true
YM_CACHE_ENABLED=true
YM_SEARCH_MAX_PAGES=3

# Meilisearch (Ozon public scraper)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key

# Ozon public scraper
OZON_PUBLIC_LOG_DIR=./logs
OZON_MAX_CONCURRENT=2
OZON_SEARXNG_CACHE_TTL=1800
OZON_OG_CACHE_TTL=3600
OZON_USE_BROWSER=true
OZON_BROWSER_WAIT_SECONDS=30
OZON_BROWSER_TOTAL_TIMEOUT_SECONDS=45
OZON_BROWSER_CACHE_ENABLED=false
OZON_BROWSER_MAX_RETRIES=1
OZON_TWO_STAGE_ENABLED=true
OZON_BROAD_SEARCH_MAX=36
OZON_ML_TOP_K=5
OZON_ENRICH_ENABLED=true
OZON_ENRICH_DELAY_SECONDS=5
OZON_ENRICH_WAIT_SECONDS=15
OZON_PIPELINE_TIMEOUT_SECONDS=180
OZON_BROWSER_WARMUP_HOME=true
OZON_BROWSER_CACHE_TTL_SECONDS=86400
