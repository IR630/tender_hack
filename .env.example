# Application
DEBUG=false
REDIS_URL=redis://localhost:6379/0
SEARXNG_URL=http://localhost:8080
CACHE_TTL_SECONDS=21600
SCRAPER_TIMEOUT_SECONDS=8.0
WB_MIN_REQUEST_INTERVAL_SECONDS=1.5
WB_CIRCUIT_BREAKER_SECONDS=600
WB_CACHE_ENABLED=true
WB_WARMUP_ENABLED=true
WB_SESSION_MAX_AGE_SECONDS=1500
WB_SESSION_IDLE_SECONDS=600
WB_SEARCH_MAX_RETRIES=1
WB_SEARCH_RETRY_DELAY_SECONDS=0.5
YM_CACHE_ENABLED=true
YM_SEARCH_MAX_PAGES=3

# Meilisearch (Ozon public scraper)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key

# Ozon public scraper
OZON_PUBLIC_LOG_DIR=./logs
OZON_MAX_CONCURRENT=2
OZON_SEARXNG_CACHE_TTL=1800
OZON_OG_CACHE_TTL=3600
OZON_USE_BROWSER=true
OZON_BROWSER_WAIT_SECONDS=30
OZON_BROWSER_TOTAL_TIMEOUT_SECONDS=45
OZON_BROWSER_CACHE_ENABLED=false
OZON_BROWSER_MAX_RETRIES=1
OZON_TWO_STAGE_ENABLED=true
OZON_BROAD_SEARCH_MAX=36
OZON_ML_TOP_K=5
OZON_ENRICH_ENABLED=true
OZON_ENRICH_DELAY_SECONDS=5
OZON_ENRICH_WAIT_SECONDS=15
OZON_PIPELINE_TIMEOUT_SECONDS=180
OZON_BROWSER_WARMUP_HOME=true
# Для ./start_demo.sh (API на хосте) — Linux с графической сессией:
# DISPLAY=:0
# Для Docker с Ozon и X11 с хоста — см. ./docker/up.sh:
# DISPLAY=:0
OZON_BROWSER_CACHE_TTL_SECONDS=86400
# OZON_DISK_CACHE_DIR=./backend/data/ozon_disk_cache

# Query spell (Yandex web, optional)
QUERY_SPELL_ENABLED=true
QUERY_SPELL_TIMEOUT_SECONDS=4
QUERY_SPELL_CACHE_TTL_SECONDS=86400

# Other (4th source) — live web search first
OTHER_SEARCH_TIMEOUT_SECONDS=45
OTHER_FETCH_CONCURRENCY=4
OTHER_CACHE_ENABLED=false
OTHER_MEILI_READ_ENABLED=false
OTHER_DDG_ENABLED=true
OTHER_YAHOO_ENABLED=true
OTHER_BING_FALLBACK_ENABLED=false
OTHER_BING_TIMEOUT_SECONDS=4
OTHER_DDG_TIMEOUT_SECONDS=4
OTHER_CATALOG_HARVEST_DEPTH=2
OTHER_CATALOG_HARVEST_MAX_LISTINGS=6
OTHER_MEILI_INDEX=other_products

# Отладка: только «Другие источники» (вернуть все: wildberries,yandex_market,other,ozon)
SEARCH_ENABLED_SOURCES=other
OTHER_PRECRAWL_DOMAINS=dns-shop.ru,citilink.ru,mvideo.ru,4tochki.ru,koleso.ru,lamoda.ru
OTHER_PRECRAWL_MAX_PER_DOMAIN=250
OTHER_LLM_ENABLED=false
